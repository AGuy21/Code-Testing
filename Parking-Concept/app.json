{
  "expo": {
    "name": "Parking-Concept",
    "scheme": "parkingapp",
    "slug": "Parking-Concept",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "associatedDomains": [
        "applinks:parkingapp.com"
      ]
    },
    "plugins": [
      "expo-secure-store",
      "expo-router",
      "@clerk/expo"
    ]
  },
  "android": {
    "adaptiveIcon": {
      "backgroundColor": "#E6F4FE",
      "foregroundImage": "./assets/android-icon-foreground.png",
      "backgroundImage": "./assets/android-icon-background.png",
      "monochromeImage": "./assets/android-icon-monochrome.png"
    },
    "predictiveBackGestureEnabled": false,
    "intentFilters": [
      {
        "action": "VIEW",
        "data": [
          {
            "scheme": "https",
            "host": "parkingapp.com",
            "pathPrefix": "/park"
          }
        ],
        "category": [
          "BROWSABLE",
          "DEFAULT"
        ]
      }
    ],
    "package": "com.anonymous.ParkingConcept"
  },
  "web": {
    "favicon": "./assets/favicon.png"
  },
  "plugins": [
    "@clerk/expo",
    "expo-secure-store"
  ]
}
