{
  "name": "functions",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@clerk/expo": "^4.2.7",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-vector-icons/ionicons": "^13.1.2",
    "@react-native-vector-icons/material-design-icons": "^13.1.2",
    "expo": "~57.0.24",
    "expo-auth-session": "~57.0.15",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.12",
    "expo-location": "~57.0.21",
    "expo-notifications": "~57.0.22",
    "expo-router": "~57.0.26",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "expo-web-browser": "~57.0.3",
    "firebase": "^12.18.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-worklets": "0.10.1"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "fix:android-deps": "npx expo install react-native-reanimated@4.5.1 react-native-worklets@0.10.1 react-native-screens@4.26.0 react-native-safe-area-context@5.7.0",
    "android:clean": "rm -rf android ~/.gradle/caches/build-cache-1 ~/.gradle/caches/transforms-4 && for m in react-native-worklets react-native-reanimated react-native-gesture-handler expo-modules-core react-native-screens react-native-safe-area-context react-native-maps; do rm -rf node_modules/$m/android/.cxx node_modules/$m/android/build; done && npx expo prebuild --clean && npx expo run:android --no-build-cache"
  },
  "private": true,
  "allowScripts": {
    "@clerk/expo@4.2.7": true,
    "browser-tabs-lock@1.3.0": true,
    "bufferutil@4.1.0": true,
    "core-js@3.47.0": true,
    "utf-8-validate@6.0.6": true,
    "@firebase/util@1.15.3": true,
    "protobufjs@7.6.6": true
  },
  "devDependencies": {
    "typescript": "~6.0.3"
  }
}
